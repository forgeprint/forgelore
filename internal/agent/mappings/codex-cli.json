{
  "mapping_version": 1,
  "agent": "codex-cli",
  "verified_against": "",
  "common": {
    "event_name": ["hook_event_name", "hookEventName", "event"],
    "session": ["session_id", "sessionId"],
    "cwd": "cwd",
    "scratchpad": ""
  },
  "events": [
    {
      "agent_event": "SessionStart",
      "kind": "session_started"
    },
    {
      "agent_event": "PostToolUse",
      "kind": "command_succeeded",
      "tools": ["shell", "bash", "Bash"],
      "tool": ["tool_name", "toolName"],
      "command": ["tool_input.command", "tool_args.command", "toolArgs.command"],
      "output": ["error", "tool_output", "tool_response.stdout", "tool_response"],
      "skip_when": ["interrupted", "is_interrupt"],
      "failure": { "field_present": "error" }
    },
    {
      "agent_event": "SessionEnd",
      "kind": "session_ended"
    }
  ],
  "response": {
    "context_path": "additionalContext"
  }
}
