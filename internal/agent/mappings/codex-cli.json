{
  "mapping_version": 2,
  "agent": "codex-cli",
  "verified_against": "",
  "common": {
    "event_name": "hook_event_name",
    "session": "session_id",
    "cwd": "cwd"
  },
  "events": [
    {
      "agent_event": "SessionStart",
      "kind": "session_started"
    },
    {
      "agent_event": "PostToolUse",
      "kind": "command_succeeded",
      "tools": [
        "shell",
        "bash",
        "Bash"
      ],
      "tool": "tool_name",
      "command": "tool_input.command",
      "output": [
        "tool_response.output",
        "tool_response.stdout",
        "tool_response"
      ],
      "failure": {
        "output_has_diagnostic": true
      }
    },
    {
      "agent_event": "SessionEnd",
      "kind": "session_ended"
    }
  ],
  "response": {
    "context_path": "hookSpecificOutput.additionalContext",
    "event_name_path": "hookSpecificOutput.hookEventName"
  }
}
