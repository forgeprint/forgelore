{
  "mapping_version": 2,
  "agent": "claude-code",
  "verified_against": "2.1.291",
  "common": {
    "event_name": "hook_event_name",
    "session": "session_id",
    "cwd": "cwd",
    "scratchpad": "scratchpad_dir",
    "transcript": "transcript_path",
    "transcript_format": "claude-code-jsonl"
  },
  "events": [
    {
      "agent_event": "SessionStart",
      "kind": "session_started"
    },
    {
      "agent_event": "PostToolUseFailure",
      "kind": "command_failed",
      "tools": [
        "Bash"
      ],
      "tool": "tool_name",
      "command": "tool_input.command",
      "output": [
        "error",
        "tool_response.stderr",
        "tool_response.stdout",
        "tool_response"
      ],
      "skip_when": "is_interrupt",
      "failure": {
        "always": true
      }
    },
    {
      "agent_event": "PostToolUse",
      "kind": "command_succeeded",
      "tools": [
        "Bash"
      ],
      "tool": "tool_name",
      "command": "tool_input.command",
      "output": [
        "tool_response.stdout",
        "tool_response"
      ],
      "skip_when": "tool_response.interrupted",
      "failure": {
        "output_has_diagnostic": true
      }
    },
    {
      "agent_event": "UserPromptSubmit",
      "kind": "prompt_submitted",
      "prompt": "prompt"
    },
    {
      "agent_event": "SessionEnd",
      "kind": "session_ended",
      "reply": "notice"
    }
  ],
  "distill": {
    "command": "claude",
    "args": ["-p", "{{instruction}}"],
    "material": "stdin",
    "timeout_ms": 120000
  },
  "response": {
    "context_path": "hookSpecificOutput.additionalContext",
    "event_name_path": "hookSpecificOutput.hookEventName",
    "notice_path": "systemMessage"
  }
}
