{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "forgelore hook --adapter claude-code", "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "forgelore hook --adapter claude-code", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "forgelore hook --adapter claude-code", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "forgelore hook --adapter claude-code", "timeout": 1 }
        ]
      }
    ]
  }
}
