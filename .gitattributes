# Normalise every text file to LF, in the repository and in the working copy.
# This project is developed on Windows with core.autocrlf enabled; a shell
# script checked out with CRLF fails on its shebang line.
* text=auto eol=lf

# Vendored code is stored exactly as upstream published it. Line-ending
# conversion here would mean the tree no longer matches what was reviewed,
# which is the whole point of vendoring it.
/vendor/** -text
